{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pacegasus API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Pacegasus Flutter",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/lib/main.dart",
      "cwd": "${workspaceFolder}/frontend",
      "preLaunchTask": "Pacegasus: prepare Android API connection",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://localhost:4000"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Pacegasus: Backend + Flutter",
      "configurations": [
        "Pacegasus API",
        "Pacegasus Flutter"
      ],
      "stopAll": true
    }
  ]
}
